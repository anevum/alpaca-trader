# Strict-trend V2 profile staged 2026-09-24
# Purpose: fewer, higher-quality intraday entries on a small live account.
# This file is documentation/staging only. Production values remain in the deployment host.

TRADING_MODE=live
EXECUTION_ENABLED=true
BOT_ARMED=true
LIVE_TRADING=true
I_ACKNOWLEDGE_LIVE_TRADING=YES
SCAN_ONLY=false

STRATEGY_NAME=rolling_momentum_vwap

# Restrict the scan universe to highly liquid large-cap names.
SCAN_SYMBOLS=NVDA,AMD,META,AAPL,MSFT,AMZN,TSLA,AVGO
ALLOWED_SYMBOLS=NVDA,AMD,META,AAPL,MSFT,AMZN,TSLA,AVGO

# Broad-market regime gate: all three must confirm.
CONFIRMATION_SYMBOLS=SPY,QQQ,SMH
MIN_CONFIRMATIONS=3

# Signal quality.
FAST_WINDOW=3
SLOW_WINDOW=10
MIN_MOMENTUM_PCT=0.0008
MIN_VWAP_EDGE_PCT=0.0003

# Keep real-money size modest until a larger live sample proves expectancy.
ORDER_NOTIONAL=20.00
MAX_ORDER_NOTIONAL=20.00
MAX_POSITION_NOTIONAL=20.00

# Exit profile.
STOP_PCT=0.004
TARGET_PCT=0.007
MAX_HOLD_MINUTES=30
REENTRY_COOLDOWN_MINUTES=10

# Avoid the opening burst and most midday chop.
ENTRY_START=09:45
ENTRY_CUTOFF=12:00
FORCE_FLAT_TIME=15:55

# Activity/risk limits.
MAX_DAILY_ORDERS=4
MAX_DAILY_LOSS=0.50
MAX_SPREAD_PCT=0.0015
MIN_READY_CASH=10.00

BAR_TIMEFRAME=1Min
LOOKBACK_BARS=500
LOOKBACK_DAYS=2
DATA_FEED=iex
POLL_SECONDS=15
