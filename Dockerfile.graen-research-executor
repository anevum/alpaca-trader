FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-graen-ml.txt ./
RUN pip install --no-cache-dir -r requirements-graen-ml.txt
COPY app ./app
COPY graen ./graen
COPY research/crypto ./research/crypto
COPY scripts ./scripts
COPY research/theory_registry.json ./research/theory_registry.json
COPY foundation ./foundation
COPY db ./db
ENV PYTHONUNBUFFERED=1
CMD ["uvicorn", "app.graen.research_executor_service:app", "--host", "0.0.0.0", "--port", "8080"]
