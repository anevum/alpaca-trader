# Alpaca credentials: add directly in the deployment host's secret manager.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# paper | live. Live can be used for read-only account monitoring.
TRADING_MODE=paper

# Reserved for the future execution layer. Keep disabled in Stage 1.
LIVE_TRADING=false
I_ACKNOWLEDGE_LIVE_TRADING=NO
BOT_ARMED=false

# Required for protected status/account endpoints.
ADMIN_TOKEN=replace-with-a-long-random-token

# Funding readiness only; this does not trigger trades.
MIN_READY_CASH=10.00

# Future execution limits. These do not cause trading by themselves.
MAX_ORDER_NOTIONAL=5.00
MAX_POSITION_NOTIONAL=10.00
MAX_DAILY_ORDERS=2
MAX_DAILY_LOSS=2.00

# Empty means no symbol is approved for future execution.
ALLOWED_SYMBOLS=
POLL_SECONDS=15
