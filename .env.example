# Alpaca credentials: add directly in the deployment host's secret manager.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# paper | live
TRADING_MODE=paper

# Execution gates. Keep false until the paper account is connected and reviewed.
EXECUTION_ENABLED=false
BOT_ARMED=false

# Live mode requires both of these in addition to the gates above.
LIVE_TRADING=false
I_ACKNOWLEDGE_LIVE_TRADING=NO

# Required for protected status/control endpoints.
ADMIN_TOKEN=replace-with-a-long-random-token

# Funding readiness monitor.
MIN_READY_CASH=10.00

# Strategy. Empty STRATEGY_SYMBOL means the engine cannot trade.
STRATEGY_NAME=sma_cross
STRATEGY_SYMBOL=
ALLOWED_SYMBOLS=
ORDER_NOTIONAL=5.00
FAST_WINDOW=20
SLOW_WINDOW=50
BAR_TIMEFRAME=5Min
LOOKBACK_BARS=120
LOOKBACK_DAYS=30
DATA_FEED=iex
POLL_SECONDS=60

# Hard risk limits.
MAX_ORDER_NOTIONAL=5.00
MAX_POSITION_NOTIONAL=10.00
MAX_DAILY_ORDERS=2
MAX_DAILY_LOSS=2.00
