# Alpaca credentials: add directly in the deployment host's secret manager.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# paper | live
TRADING_MODE=paper

# Keep live execution disabled while proving the strategy in paper.
EXECUTION_ENABLED=false
BOT_ARMED=false
LIVE_TRADING=false
I_ACKNOWLEDGE_LIVE_TRADING=NO

ADMIN_TOKEN=replace-with-a-long-random-token
MIN_READY_CASH=10.00

# Opening-range + VWAP strategy.
STRATEGY_NAME=opening_range_vwap
STRATEGY_SYMBOL=SPY
ALLOWED_SYMBOLS=SPY
CONFIRMATION_SYMBOLS=QQQ,SMH
ORDER_NOTIONAL=75.00
OPENING_RANGE_MINUTES=5
STOP_PCT=0.006
TARGET_PCT=0.0108
ENTRY_START=09:35
ENTRY_CUTOFF=11:30
FORCE_FLAT_TIME=15:55
BAR_TIMEFRAME=1Min
LOOKBACK_BARS=500
LOOKBACK_DAYS=2
DATA_FEED=iex
POLL_SECONDS=15

# Hard small-account risk limits.
MAX_ORDER_NOTIONAL=80.35
MAX_POSITION_NOTIONAL=80.35
MAX_DAILY_ORDERS=2
MAX_DAILY_LOSS=1.00
