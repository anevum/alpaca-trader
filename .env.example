# Alpaca credentials: add directly in the deployment host's secret manager.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# paper | live
TRADING_MODE=paper

# Keep live execution disabled while proving the strategy in paper.
EXECUTION_ENABLED=false
BOT_ARMED=false
LIVE_TRADING=false
I_ACKNOWLEDGE_LIVE_TRADING=NO

ADMIN_TOKEN=replace-with-a-long-random-token
MIN_READY_CASH=10.00

# Intraday rolling momentum + VWAP strategy.
STRATEGY_NAME=rolling_momentum_vwap
STRATEGY_SYMBOL=SPY
ALLOWED_SYMBOLS=SPY
DYNAMIC_UNIVERSE_ENABLED=true
UNIVERSE_SIZE=100
UNIVERSE_CANDIDATE_POOL_SIZE=300
UNIVERSE_REFRESH_SECONDS=300
UNIVERSE_DAILY_LOOKBACK=5
UNIVERSE_DATA_BATCH_SIZE=50
UNIVERSE_MIN_PRICE=2.00
UNIVERSE_MIN_AVG_VOLUME=10000
UNIVERSE_MIN_AVG_DOLLAR_VOLUME=500000
UNIVERSE_EXCHANGES=NASDAQ,NYSE,ARCA,AMEX,BATS
UNIVERSE_ALWAYS_INCLUDE=SPY,QQQ,SMH
CONFIRMATION_SYMBOLS=QQQ,SMH
MIN_CONFIRMATIONS=1
FAST_WINDOW=3
SLOW_WINDOW=8
MIN_MOMENTUM_PCT=0.0005
MIN_VWAP_EDGE_PCT=0
# Fallback notional is retained for fixed sizing and diagnostics.
ORDER_NOTIONAL=20.00
SIZING_MODE=equity_risk
RISK_PER_TRADE_PCT=0.001
MAX_GROSS_EXPOSURE_PCT=0.80
MIN_ORDER_NOTIONAL=1.00
PORTFOLIO_LIMIT_MODE=risk
MAX_POSITION_GROSS_PCT=0.25
MAX_PORTFOLIO_STOP_RISK_PCT=0.01
OPENING_RANGE_MINUTES=1
STOP_PCT=0.0035
TARGET_PCT=0.005
ENTRY_START=09:31
ENTRY_CUTOFF=15:30
FORCE_FLAT_TIME=15:55
MAX_HOLD_MINUTES=15
REENTRY_COOLDOWN_MINUTES=2
BAR_TIMEFRAME=1Min
LOOKBACK_BARS=500
LOOKBACK_DAYS=2
DATA_FEED=iex
POLL_SECONDS=15

# Hard small-account risk limits.
MAX_ORDER_NOTIONAL=80.35
MAX_POSITION_NOTIONAL=80.35
MAX_CONCURRENT_POSITIONS=0
MAX_NEW_ENTRIES_PER_CYCLE=0
MAX_TOTAL_POSITION_NOTIONAL=250.00
MAX_DAILY_ORDERS=0
MAX_DAILY_LOSS=1.00

# Reject stale/thin candidate data before submitting a live entry.
MAX_BAR_AGE_SECONDS=90
MARKET_DATA_BATCH_SIZE=25
MAX_SPREAD_PCT=0.002
MIN_QUALITY_SCORE=80
MAX_PAIRWISE_CORRELATION=0.85
CORRELATION_LOOKBACK_BARS=30
CORRELATION_MIN_OBSERVATIONS=8

# Durable canonical ledger. Keep these backend-only.
TRADING_INGEST_URL=
TRADING_INGEST_TOKEN=
TRADING_RUN_ID=
STRATEGY_VERSION_ID=
# Fixed ISO-8601 start for this run; keep unchanged across Railway restarts.
TRADING_RUN_STARTED_AT=
LEDGER_RECONCILE_SECONDS=60

REGIME_WINDOW=5
REGIME_MIN_CONFIRMATIONS=1
REGIME_MIN_RETURN_PCT=0
MAX_VWAP_EXTENSION_PCT=0.008
LOSS_STREAK_LIMIT=2
LOSS_STREAK_COOLDOWN_MINUTES=10

# Exit Engine v2: broker protection, volatility-aware risk, profit ratchet, thesis failure.
BROKER_PROTECTIVE_STOP_ENABLED=false
VOLATILITY_STOP_ENABLED=false
VOLATILITY_STOP_MULTIPLIER=2.0
VOLATILITY_STOP_LOOKBACK_BARS=8
MAX_DYNAMIC_STOP_PCT=0.006
PROFIT_PROTECT_ACTIVATION_PCT=0.001
PROFIT_PROTECT_RETAIN_FRACTION=0.50
PROFIT_PROTECT_MIN_PCT=0.0003
PROFIT_STOP_STEP_PCT=0.0002
THESIS_EXIT_ENABLED=false
THESIS_FAILURE_CYCLES=2
THESIS_EXIT_MAX_RETURN_PCT=0.0005

PROFIT_PROTECT_ENABLED=false

# RHEN Pre-Open State v1. Run in a separate shadow-only service.
PREOPEN_STATE_ENABLED=false
PREOPEN_SHADOW_ONLY=true
PREOPEN_TARGET_SYMBOLS=SPY,QQQ
PREOPEN_PROXY_SYMBOLS=FEZ,EWJ,EEM,TLT,UUP,USO,GLD,VXX
PREOPEN_POLL_SECONDS=20
PREOPEN_CAPTURE_GRACE_MINUTES=12
# Optional checksum-bound research/shadow model artifact. Never authorizes execution.
PREOPEN_MODEL_JSON=

# Optional, operator-reviewed session cash-flow manifest. Empty preserves existing behavior.
# See docs/session-cash-flow-accounting.md. Never paste a lifetime withdrawal total.
SESSION_CASH_FLOW_ADJUSTMENT=

