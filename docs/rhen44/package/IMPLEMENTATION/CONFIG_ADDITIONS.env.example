# RHEN 4.4 Real-Time Market Fabric. Ship shadow/disabled for behavior changes.
RHEN_MARKET_STREAM_ENABLED=true
RHEN_MARKET_DATA_TIER=basic
RHEN_MARKET_DATA_STOCK_FEED=iex
RHEN_MARKET_DATA_OVERNIGHT_FEED=overnight
RHEN_MARKET_STREAM_INTENDED_SYMBOL_LIMIT=24
RHEN_MARKET_STREAM_EXPECTED_PLAN_SYMBOL_CAP=30
RHEN_MARKET_STREAM_QUOTE_MAX_AGE_SECONDS=45
RHEN_MARKET_STREAM_BAR_MAX_AGE_SECONDS=120
RHEN_MARKET_STREAM_QUEUE_MAX=10000
RHEN_MARKET_STREAM_LAG_KILL_SECONDS=5
RHEN_MARKET_STREAM_RECONCILE_SECONDS=60
RHEN_MARKET_STREAM_WARMSTART_BARS=15
RHEN_MARKET_STREAM_REQUIRE_FULL_SUBSCRIPTION=true
RHEN_EXTENDED_EXECUTION_PROMOTION=false
RHEN_OVERNIGHT_EXECUTION_PROMOTION=false

# Command real-time publisher. This affects UI publication, not engine processing.
COMMAND_LIVE_STREAM_ENABLED=true
COMMAND_LIVE_FLUSH_MS=125
COMMAND_LIVE_HEARTBEAT_SECONDS=2
COMMAND_LIVE_MAX_BATCH_SYMBOLS=30


# Command Visual Intelligence. Presentation only; no broker-write authority.
COMMAND_VISUAL_INTELLIGENCE_ENABLED=true
COMMAND_VISUAL_SERIES_MAX_LIVE_POINTS=2400
COMMAND_VISUAL_SCANNER_SPARKLINE_POINTS=120
COMMAND_VISUAL_HISTORY_MAX_POINTS=5000
COMMAND_VISUAL_FORECAST_ENABLED=true
COMMAND_VISUAL_REPLAY_ENABLED=true
COMMAND_VISUAL_PROVENANCE_REQUIRED=true
COMMAND_VISUAL_ALLOW_SYNTHETIC_MARKET_POINTS=false
COMMAND_VISUAL_CRITICAL_EVENTS_IMMEDIATE=true

# RHEN 4.4 Adaptive Policy Control. Ship disabled/shadow.
ADAPTIVE_POLICY_ENABLED=false
ADAPTIVE_POLICY_MODE=shadow
ADAPTIVE_POLICY_LIBRARY_VERSION=adaptive-policy-library-v1
ADAPTIVE_POLICY_REFRESH_SECONDS=300
ADAPTIVE_POLICY_MIN_DWELL_SECONDS=900
ADAPTIVE_POLICY_UPGRADE_CONFIRMATIONS=2
ADAPTIVE_POLICY_DOWNGRADE_CONFIRMATIONS=2
ADAPTIVE_POLICY_SAFETY_DOWNGRADE_CONFIRMATIONS=1
ADAPTIVE_POLICY_MIN_UPGRADE_CONFIDENCE=0.75
ADAPTIVE_POLICY_MAX_REGIME_AGE_SECONDS=600
ADAPTIVE_POLICY_ALLOW_MARGIN=false

# Runtime NOSTRA state. Classification itself has no execution authority.
NOSTRA_RUNTIME_REGIME_ENABLED=false
NOSTRA_RUNTIME_REGIME_REFRESH_SECONDS=300
NOSTRA_RUNTIME_REGIME_MAX_STATE_AGE_SECONDS=600

# Capital governor. Supervisory fractions of existing hard risk limits.
CAPITAL_GOVERNOR_ENABLED=false
CAPITAL_GOVERNOR_MIN_THROTTLE=0.00
CAPITAL_GOVERNOR_MAX_THROTTLE=1.00
CAPITAL_GOVERNOR_DRAWDOWN_THROTTLE_ENABLED=true
CAPITAL_GOVERNOR_HEALTH_THROTTLE_ENABLED=true
CAPITAL_GOVERNOR_EVIDENCE_THROTTLE_ENABLED=true

# Persistence/Command
ADAPTIVE_POLICY_PERSIST_OBSERVATIONS=true
ADAPTIVE_POLICY_PERSIST_MIN_INTERVAL_SECONDS=300
ADAPTIVE_POLICY_COMMAND_HISTORY_LIMIT=100
