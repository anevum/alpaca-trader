# RHEN Research Agent v1 — separate Railway service only.
RHEN_RESEARCH_AGENT_ENABLED=true
RHEN_RESEARCH_GATEWAY_URL=
RHEN_RESEARCH_GATEWAY_TOKEN=
RHEN_RESEARCH_ADMIN_TOKEN=
RHEN_RESEARCH_SOURCE_COMMIT=
RHEN_RESEARCH_PERSIST_RUNS=true

# Semantic model remains explicitly gated even when an API key exists.
RHEN_RESEARCH_MODEL_ENABLED=false
OPENAI_API_KEY=
RHEN_RESEARCH_MODEL=gpt-5.6-terra
RHEN_RESEARCH_REASONING_EFFORT=high

# Do not add Alpaca credentials or live-execution variables to this service.
